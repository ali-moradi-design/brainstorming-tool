{
  "name": "Ideabloom",
  "short_name": "Ideabloom",
  "description": "A local-first mind map for your ideas.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#132a13",
  "theme_color": "#31572c",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ]
}
